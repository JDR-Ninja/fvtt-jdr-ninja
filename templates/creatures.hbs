<div class="standard-form jn-creatures">
  <div class="jn-creature-compatibility" role="status" data-compatibility="{{compatibility.code}}">
    <span class="badge"><i class="fa-solid {{compatibility.icon}}" aria-hidden="true"></i> {{compatibility.label}}</span>
    <p>{{compatibility.current}}</p>
    <p class="hint">{{localize "JDRNINJA.creatures.error.incompatibleSystem"}}</p>
  </div>
  <div class="jdr-ninja__status" aria-live="polite">
    <span><i class="fa-solid fa-gem" aria-hidden="true"></i> {{localize "JDRNINJA.creatures.premium"}}</span>
    <strong>{{status}}</strong>
  </div>
  {{#if showSubscriptionLink}}<p><a href="{{subscriptionsUrl}}" target="_blank" rel="noopener noreferrer" data-jdr-subscriptions="creatures">{{localize "JDRNINJA.creatures.subscription"}}</a></p>{{/if}}
  <div class="jdr-ninja__actions">
    <button type="button" data-action="connections">{{localize "JDRNINJA.creatures.connections"}}</button>
    <button type="button" data-action="subscription">{{localize "JDRNINJA.creatures.subscription"}}</button>
    <button type="button" data-action="check" {{#if busy}}disabled{{/if}}>{{localize "JDRNINJA.creatures.check"}}</button>
  </div>
  {{#if error}}<p role="alert">{{error}}</p>{{/if}}
  {{#if cooldown}}<p role="status">{{cooldownText}}</p>{{/if}}
  {{#if hasCatalog}}
    <fieldset {{#if busy}}disabled{{/if}}>
      <legend>{{title}}</legend>
      {{#each primaryFields}}
        <div class="form-group">
          <label for="{{id}}">{{label}}</label>
          <select id="{{id}}" name="{{name}}" data-creature-option aria-invalid="{{error}}">
            {{#if unavailableSelection}}<option selected value="{{value}}">{{value}} ({{localize "JDRNINJA.creatures.unavailableChoice"}})</option>{{/if}}
            {{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{#if description}}<p class="hint">{{description}}</p>{{/if}}
        </div>
      {{/each}}
      {{#if recommendation}}<p>{{localize "JDRNINJA.creatures.recommendation"}} {{recommendation}}</p>{{/if}}
      {{#if hasAdvanced}}
        <details data-creature-advanced {{#if advanced}}open{{/if}}>
          <summary>{{localize "JDRNINJA.creatures.advanced"}}</summary>
          {{#each advancedFields}}
            <div class="form-group">
              <label for="{{id}}">{{label}}</label>
              {{#if boolean}}
                <input id="{{id}}" name="{{name}}" type="checkbox" data-creature-option {{#if value}}checked{{/if}} aria-invalid="{{error}}">
              {{else}}
                <select id="{{id}}" name="{{name}}" data-creature-option aria-invalid="{{error}}">
                  {{#if unavailableSelection}}<option selected value="{{value}}">{{value}} ({{localize "JDRNINJA.creatures.unavailableChoice"}})</option>{{/if}}
                  {{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              {{/if}}
            </div>
          {{/each}}
        </details>
      {{/if}}
    </fieldset>
    {{#if invalidOptions}}<p role="alert">{{localize "JDRNINJA.creatures.error.invalidOptions"}}</p>{{/if}}
    <div class="jdr-ninja__actions">
      <button type="button" data-action="generate" {{#unless canGenerate}}disabled{{/unless}}>
        {{#if regenerating}}{{localize "JDRNINJA.creatures.regenerate"}}{{else}}{{localize "JDRNINJA.creatures.generate"}}{{/if}}
      </button>
      {{#if busy}}<button type="button" data-action="cancel">{{localize "JDRNINJA.button.cancel"}}</button>{{/if}}
    </div>
  {{/if}}
  {{#if preview}}
    <section class="jn-creature-preview">
      <h2>{{preview.name}}</h2>
      <p>{{localize "JDRNINJA.creatures.field.challengeRating"}} {{preview.challengeRating}} · {{localize "JDRNINJA.creatures.ac"}} {{preview.summary.ac}} · {{localize "JDRNINJA.creatures.hp"}} {{preview.summary.hp}}</p>
      {{#if preview.changed}}<p>{{localize "JDRNINJA.creatures.changed"}}</p>{{/if}}
      <p>{{localize "JDRNINJA.creatures.manualLimit"}}</p>
      <div class="jn-creature-biography">{{{preview.biography}}}</div>
      <details><summary>{{localize "JDRNINJA.creatures.rules"}}</summary>
        {{#each preview.entries}}<h3>{{name}}</h3><div>{{{description}}}</div>{{/each}}
      </details>
    </section>
    <fieldset {{#if busy}}disabled{{/if}}>
      <legend>{{localize "JDRNINJA.creatures.destination"}}</legend>
      <p>{{localize "JDRNINJA.creatures.destinationHint"}}</p>
      <p><strong>{{worldName}}</strong></p>
      <div class="form-group"><label for="jn-{{kind}}-name">{{localize "JDRNINJA.creatures.actorName"}}</label>
        <input id="jn-{{kind}}-name" name="importName" value="{{name}}" maxlength="256"></div>
      <div class="form-group"><label for="jn-{{kind}}-folder">{{localize "JDRNINJA.creatures.actorFolder"}}</label>
        <select id="jn-{{kind}}-folder" name="importFolder"><option value="">{{localize "JDRNINJA.creatures.rootFolder"}}</option>
          {{#each folders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select></div>
    </fieldset>
    <div class="jdr-ninja__actions">
      <button type="button" data-action="create" {{#unless canCreate}}disabled{{/unless}}>{{localize "JDRNINJA.creatures.create"}}</button>
      {{#if imported}}<span role="status">{{localize "JDRNINJA.creatures.imported"}}</span><button type="button" data-action="sheet">{{localize "JDRNINJA.creatures.sheet"}}</button>{{/if}}
      <button type="button" data-action="dismiss" {{#if busy}}disabled{{/if}}>{{localize "JDRNINJA.creatures.dismiss"}}</button>
    </div>
  {{/if}}
</div>
