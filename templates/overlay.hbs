<div class="standard-form jn-layout jn-overlay">
  <div class="jn-scroll">
    {{#if status}}<div class="jn-status-line" data-status="{{status.state}}">
      {{#if status.pill}}<span class="jn-pill jn-pill--{{status.pill.level}}" role="status"><i class="fa-solid {{status.pill.icon}}" aria-hidden="true"></i> {{status.pill.label}}</span>{{/if}}
      {{#if status.step}}<div class="notice notice-{{status.step.level}}">
        {{#if status.step.text}}<p role="{{status.step.role}}">{{status.step.text}}</p>{{/if}}
        {{#if status.step.detail}}<p>{{status.step.detail}}</p>{{/if}}
        {{#if status.step.action}}<button type="button" data-action="{{status.step.action.name}}"><i class="fa-solid {{status.step.action.icon}}" aria-hidden="true"></i> {{status.step.action.label}}</button>{{/if}}
        {{#if status.step.link}}<a href="{{status.step.link.href}}" target="_blank" rel="noopener noreferrer" data-jdr-subscriptions="{{status.step.link.kind}}">{{status.step.link.label}}</a>{{/if}}
      </div>{{/if}}
    </div>{{/if}}
    {{#if error}}<p class="notice notice-warning" role="alert">{{error}}</p>{{/if}}

    <section class="jn-section" aria-labelledby="jdr-ninja-overlay-title-sending">
      <h3 class="jn-section__title" id="jdr-ninja-overlay-title-sending">
        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> {{localize "JDRNINJA.overlay.sendingTitle"}}
      </h3>
      <div class="form-group">
        <label for="jdr-ninja-overlay-filter">{{localize "JDRNINJA.overlay.filter"}}</label>
        <div class="form-fields">
          <select id="jdr-ninja-overlay-filter" name="overlayForwardFilter" {{#if busy}}disabled{{/if}}>
            {{#each filters}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        <p class="hint">{{localize "JDRNINJA.overlay.filterHint"}}</p>
      </div>
      <div class="form-group">
        <label for="jdr-ninja-overlay-hold">{{localize "JDRNINJA.overlay.hold"}}</label>
        <div class="form-fields">
          <select id="jdr-ninja-overlay-hold" name="overlayCardHoldSeconds" {{#if busy}}disabled{{/if}}>
            {{#each holds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        <i class="fa-solid fa-circle-info jn-info" tabindex="0" role="img"
           aria-label="{{localize "JDRNINJA.overlay.holdHint"}}" data-tooltip="{{localize "JDRNINJA.overlay.holdHint"}}"></i>
      </div>
    </section>

    {{#if isGM}}
      <section class="jn-section" aria-labelledby="jdr-ninja-overlay-title-tables">
        <h3 class="jn-section__title" id="jdr-ninja-overlay-title-tables">
          <i class="fa-brands fa-twitch" aria-hidden="true"></i> {{localize "JDRNINJA.overlay.tablesTitle"}}
        </h3>
        <div class="form-group jn-check">
          <div class="form-fields">
            <input id="jdr-ninja-overlay-tables" name="overlayTableCommandsEnabled" type="checkbox" {{#if tableCommands}}checked{{/if}} {{#if busy}}disabled{{/if}}>
          </div>
          <label for="jdr-ninja-overlay-tables">{{localize "JDRNINJA.overlay.tablesEnable"}}</label>
          <i class="fa-solid fa-circle-info jn-info" tabindex="0" role="img"
             aria-label="{{localize "JDRNINJA.overlay.tableCommandsHint"}}" data-tooltip="{{localize "JDRNINJA.overlay.tableCommandsHint"}}"></i>
        </div>
        <div class="jn-toolbar">
          <button type="button" data-action="commands">
            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {{localize "JDRNINJA.overlay.manageCommands"}}
          </button>
          <i class="fa-solid fa-circle-info jn-info" tabindex="0" role="img"
             aria-label="{{localize "JDRNINJA.overlay.tablesHint"}}" data-tooltip="{{localize "JDRNINJA.overlay.tablesHint"}}"></i>
        </div>
      </section>
    {{/if}}

    {{#if showDiagnostics}}
      <section class="jn-section" aria-labelledby="jdr-ninja-overlay-title-diagnostics">
        <h3 class="jn-section__title" id="jdr-ninja-overlay-title-diagnostics">
          <i class="fa-solid fa-stethoscope" aria-hidden="true"></i> {{localize "JDRNINJA.overlay.diagnostics"}}
        </h3>
        {{#if hasDiagnostics}}
          <dl class="jn-diagnostics" aria-live="polite">
            {{#each rows}}
              <div class="jn-diagnostic">
                <dt>{{label}}</dt>
                <dd>
                  {{#if level}}
                    <span class="jn-pill jn-pill--{{level}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{message}}</span>
                  {{else}}{{message}}{{/if}}
                </dd>
              </div>
            {{/each}}
          </dl>
        {{/if}}
        {{#if lastSuccess}}<p class="jn-muted">{{lastSuccess}}</p>{{/if}}
        {{#if lastError}}<p class="notice notice-warning">{{lastError}}</p>{{/if}}
      </section>
    {{/if}}
  </div>

  <footer class="form-footer jn-footer">
    <button type="button" class="bright" data-action="testRoll" data-tooltip="{{localize "JDRNINJA.overlay.testHint"}}" {{#unless canTest}}disabled{{/unless}}>
      <i class="fa-solid fa-dice-d20" aria-hidden="true"></i> {{localize "JDRNINJA.overlay.test"}}
    </button>
    <button type="button" data-action="diagnostics" {{#unless canCheck}}disabled{{/unless}}>
      <i class="fa-solid fa-satellite-dish" aria-hidden="true"></i> {{localize "JDRNINJA.overlay.check"}}
    </button>
    {{#if busy}}<button type="button" data-action="cancel">{{localize "JDRNINJA.button.cancel"}}</button>{{/if}}
  </footer>
</div>
